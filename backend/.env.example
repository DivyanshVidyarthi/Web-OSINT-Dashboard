# --- App ---
ENV=development
DEBUG=true

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# --- Database ---
DATABASE_PATH=./data/osint_dashboard.db

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=10

# --- Timeouts ---
REQUEST_TIMEOUT_SECONDS=8

# --- Threat intelligence (all optional — leave blank to disable) ---
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
ALIENVAULT_API_KEY=
SHODAN_API_KEY=

# --- Geolocation provider ---
IP_GEOLOCATION_PROVIDER=ip-api
